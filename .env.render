# Environment Configuration for Render Deployment
# Copy this file to .env and fill in the values based on your Render deployment

# ============================================
# Database Configuration
# ============================================
# Provided by Render's PostgreSQL service
SPRING_DATASOURCE_URL=jdbc:postgresql://[render-postgres-host]:5432/petstore_db
SPRING_DATASOURCE_USERNAME=petstore_user
SPRING_DATASOURCE_PASSWORD=[generated-by-render]
DATABASE_HOST=[render-postgres-host]
DATABASE_PORT=5432
DATABASE_NAME=petstore_db
DATABASE_USER=petstore_user
DATABASE_PASSWORD=[generated-by-render]

# ============================================
# Backend Configuration
# ============================================
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Backend Server
BACKEND_PORT=8080
JAVA_OPTS=-Xmx512m

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=https://petstore-[your-app-name].onrender.com
FRONTEND_PORT=3000

# ============================================
# Application Environment
# ============================================
NODE_ENV=production
JAVA_ENV=production

# ============================================
# Logging
# ============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_PETSTORE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_HIBERNATE=WARN

# ============================================
# Performance & Security
# ============================================
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=10
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=1024
