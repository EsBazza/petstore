# .dockerignore - Exclude files from Docker build context

# Frontend
frontend/node_modules
frontend/dist
frontend/.eslintcache
frontend/coverage

# Backend
backend/target
backend/.classpath
backend/.project
backend/.settings

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Version Control
.git
.gitignore
.github

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Documentation
*.md
RENDER_DEPLOYMENT_GUIDE.md
RENDER_PRODUCTION_CONFIG.md
IMPLEMENTATION_SUMMARY.md
README.md

# Specs
specs/
.specify/

# Development
docker-compose.yml
.editorconfig

# Test files
frontend/**/*.test.js
backend/src/test
